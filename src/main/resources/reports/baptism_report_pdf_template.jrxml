	<queryString>
		<![CDATA[SELECT
    A.*,
    COUNT(CASE WHEN age_category = 'A' THEN 1 END) OVER() AS category_1_total,
    COUNT(CASE WHEN age_category = 'B' THEN 1 END) OVER() AS category_2_total,
    COUNT(CASE WHEN age_category = 'C' THEN 1 END) OVER() AS category_3_total
FROM baptism_records A
WHERE date_of_baptism BETWEEN $P{P_DATE_FROM} AND $P{P_DATE_TO} ORDER BY A.DATE_OF_BAPTISM ASC;]]>
	</queryString>
